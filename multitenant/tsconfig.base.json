{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "paths": {
      "@multitenant/api-manager": ["./libs/api-manager/src/index.ts"],
      "@multitenant/phasetwo-orgs-api": [
        "./libs/phasetwo-orgs-api/src/index.ts"
      ],
      "@multitenant/ui-shared": ["./libs/ui-shared/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
